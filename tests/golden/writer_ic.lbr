    <library>
      <description>&lt;b&gt;lcsc2fusion library&lt;/b&gt;
&lt;p&gt;Golden: IC&lt;/p&gt;
&lt;p&gt;LCSC parts: C000001&lt;/p&gt;
&lt;p&gt;Source: JLCEDA/EasyEDA Official Library (https://lceda.cn/ , https://easyeda.com). Copyright of the library data belongs to JLCEDA/EasyEDA.&lt;/p&gt;</description>
      <packages>
        <package name="QFN-8-EP_3X3">
          <description>Synthetic 8 pin QFN with thermal pad and a slotted shield pad</description>
          <smd name="1" x="-1.5" y="0.75" dx="0.8" dy="0.3" layer="1" roundness="0"/>
          <smd name="2" x="-1.5" y="0.25" dx="0.8" dy="0.3" layer="1" roundness="0"/>
          <smd name="3" x="-1.5" y="-0.25" dx="0.8" dy="0.3" layer="1" roundness="0"/>
          <smd name="4" x="-1.5" y="-0.75" dx="0.8" dy="0.3" layer="1" roundness="0"/>
          <smd name="5" x="1.5" y="-0.75" dx="0.8" dy="0.3" layer="1" roundness="0"/>
          <smd name="6" x="1.5" y="-0.25" dx="0.8" dy="0.3" layer="1" roundness="0"/>
          <smd name="7" x="1.5" y="0.25" dx="0.8" dy="0.3" layer="1" roundness="0"/>
          <smd name="8" x="1.5" y="0.75" dx="0.8" dy="0.3" layer="1" roundness="0"/>
          <smd name="9" x="0" y="0.6" dx="1.7" dy="1" layer="1" roundness="0"/>
          <smd name="9_2" x="0" y="-0.6" dx="1.7" dy="1" layer="1" roundness="0"/>
          <pad name="10" x="0" y="-3" drill="0.6" diameter="1.2" shape="long"/>
          <wire x1="-0.6" y1="-3.3" x2="0.6" y2="-3.3" width="0.02" layer="46"/>
          <wire x1="0.6" y1="-3.3" x2="0.6" y2="-2.7" width="0.02" layer="46" curve="180"/>
          <wire x1="0.6" y1="-2.7" x2="-0.6" y2="-2.7" width="0.02" layer="46"/>
          <wire x1="-0.6" y1="-2.7" x2="-0.6" y2="-3.3" width="0.02" layer="46" curve="180"/>
          <hole x="3" y="3" drill="1"/>
          <wire x1="-1.6" y1="1.6" x2="1.6" y2="1.6" width="0.15" layer="21"/>
          <wire x1="1.6" y1="-1.6" x2="-1.6" y2="-1.6" width="0.15" layer="21" curve="-90"/>
          <circle x="-2" y="1" radius="0.1" width="0" layer="21"/>
          <rectangle x1="-1.5" y1="-1.5" x2="1.5" y2="1.5" layer="51"/>
          <polygon width="0.01" layer="51">
            <vertex x="-1.5" y="1.5"/>
            <vertex x="-1" y="1.5"/>
            <vertex x="-1.5" y="1"/>
          </polygon>
          <text x="0" y="2.2" size="0.8" layer="25" font="vector" ratio="12" rot="R90" align="center">&gt;NAME</text>
          <text x="0" y="-4" size="0.8" layer="27" font="vector" ratio="12">&gt;VALUE</text>
        </package>
      </packages>
      <symbols>
        <symbol name="TPS-TEST1">
          <wire x1="-7.62" y1="-7.62" x2="7.62" y2="-7.62" width="0.254" layer="94"/>
          <wire x1="7.62" y1="-7.62" x2="7.62" y2="7.62" width="0.254" layer="94"/>
          <wire x1="7.62" y1="7.62" x2="-7.62" y2="7.62" width="0.254" layer="94"/>
          <wire x1="-7.62" y1="7.62" x2="-7.62" y2="-7.62" width="0.254" layer="94"/>
          <text x="-7.62" y="8.89" size="1.778" layer="95" font="vector" ratio="12">&gt;NAME</text>
          <text x="-7.62" y="-10.16" size="1.778" layer="96" font="vector" ratio="12">&gt;VALUE</text>
          <pin name="VIN" x="-10.16" y="5.08" visible="both" length="short" direction="pwr"/>
          <pin name="EN" x="-10.16" y="2.54" visible="both" length="short" direction="in" function="dot"/>
          <pin name="CLK" x="-10.16" y="0" visible="both" length="short" direction="in" function="clk"/>
          <pin name="RST" x="-10.16" y="-2.54" visible="both" length="short" direction="in" function="dotclk"/>
          <pin name="OUT" x="10.16" y="5.08" visible="both" length="short" direction="out" rot="R180"/>
          <pin name="FB" x="10.16" y="2.54" visible="both" length="short" direction="io" rot="R180"/>
          <pin name="NC" x="10.16" y="0" visible="both" length="short" direction="nc" rot="R180"/>
          <pin name="VCC" x="10.16" y="-2.54" visible="both" length="short" direction="sup" rot="R180"/>
          <pin name="EP" x="0" y="-10.16" visible="both" length="short" direction="pas" rot="R90"/>
          <pin name="SH" x="0" y="10.16" visible="both" length="short" direction="pas" rot="R270"/>
