      <devicesets>
        <deviceset name="TPS-TEST1" prefix="U">
          <description>&lt;b&gt;TPS-TEST1&lt;/b&gt;
&lt;p&gt;Step-down converter &amp;lt;3A &amp;amp; 2.5V to 5.5V&lt;/p&gt;
&lt;p&gt;Source: JLCEDA/EasyEDA Official Library (https://lceda.cn/ , https://easyeda.com). Copyright of the library data belongs to JLCEDA/EasyEDA.&lt;/p&gt;</description>
          <gates>
            <gate name="G$1" symbol="TPS-TEST1" x="0" y="0"/>
          </gates>
          <devices>
            <device name="" package="QFN-8-EP_3X3">
              <connects>
                <connect gate="G$1" pin="VIN" pad="1"/>
                <connect gate="G$1" pin="EN" pad="2"/>
                <connect gate="G$1" pin="CLK" pad="3"/>
                <connect gate="G$1" pin="RST" pad="4"/>
                <connect gate="G$1" pin="OUT" pad="5"/>
                <connect gate="G$1" pin="FB" pad="6"/>
                <connect gate="G$1" pin="NC" pad="7"/>
                <connect gate="G$1" pin="VCC" pad="8"/>
                <connect gate="G$1" pin="EP" pad="9 9_2"/>
                <connect gate="G$1" pin="SH" pad="10"/>
              </connects>
              <technologies>
                <technology name="">
                  <attribute name="MPN" value="TPS-TEST1" constant="no"/>
                  <attribute name="MANUFACTURER" value="Test Mfr &amp; Sons" constant="no"/>
                  <attribute name="LCSC_PART" value="C000001" constant="no"/>
                  <attribute name="DATASHEET" value="https://example.com/ds.pdf?a=1&amp;b=2" constant="no"/>
                  <attribute name="PACKAGE" value="QFN-8" constant="no"/>
                  <attribute name="SUPPLY_VOLTAGE" value="5V" constant="no"/>
                  <attribute name="SOURCE" value="Source: JLCEDA/EasyEDA Official Library (https://lceda.cn/ , https://easyeda.com). Copyright of the library data belongs to JLCEDA/EasyEDA." constant="no"/>
                </technology>
